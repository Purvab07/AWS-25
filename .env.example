# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
# `.env` is gitignored — never commit real credentials.
#
# The start script loads `.env` automatically if present.

# --- Database -----------------------------------------------------------
# RDS connection string. Ask a teammate for the master password; the endpoint
# is in docs/aws-setup.md. Do NOT commit the filled-in value.
DATABASE_URL=postgresql://ftadmin:REPLACE_WITH_DB_PASSWORD@food-traceback-db.cqgkvonwoxhz.us-east-1.rds.amazonaws.com:5432/foodtraceback

# --- AWS (for Bedrock) --------------------------------------------------
# Paste your OWN short-lived credentials from the Workshop portal
# ("Get AWS CLI credentials"). These expire; re-paste when they do.
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_SESSION_TOKEN=REPLACE_ME
AWS_DEFAULT_REGION=us-east-1
